---
import {
  IconArrowUpRight,
  IconBrandGithub,
  IconBrandLinkedin,
  IconMail,
  IconPhone,
} from "@tabler/icons-astro";
import ButtonLink from "../../components/ButtonLink.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { getLocale, localeMeta, localizedPath, t } from "../../i18n";
import AboutSection from "../../sections/about/AboutSection.astro";
import ProcessSection from "../../sections/process/ProcessSection.astro";

const lang = getLocale(Astro.currentLocale);
const pathname = localizedPath("sobre-mi", lang);
const title = `${t("about.eyebrow", lang)} | ${site.name}`;
const description = t("seo.aboutDescription", lang);
const eyebrow =
  "font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]";
const sectionClass = "border-t border-[var(--color-border)]/60 py-18";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: title,
    url: new URL(pathname, site.url).toString(),
    inLanguage: localeMeta[lang].lang,
    description,
    mainEntity: {
      "@type": "Person",
      name: site.fullName,
      alternateName: site.name,
      url: site.url,
      email: `mailto:${site.email}`,
      telephone: site.phone,
      sameAs: [site.linkedin, site.github],
      jobTitle: t("cv.role", lang),
    },
  },
];
---

<Layout
  title={title}
  description={description}
  pathname={pathname}
  image="/mauricio-dmo.webp"
  structuredData={structuredData}
>
  <SiteHeader />

  <main>
    <section class="mx-auto grid w-[min(calc(100%-2rem),1120px)] items-center gap-9 py-16 md:grid-cols-[1fr_auto] md:gap-14 md:py-20">
      <div>
        <p class={eyebrow}>{t("about.eyebrow", lang)}</p>
        <h1 class="mt-5 text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-[-0.07em] text-[var(--color-text)]">
          {site.fullName}
        </h1>
        <p class="mt-4 text-xl text-[var(--color-text)]">
          {t("cv.role", lang)} · {site.availability.location}
        </p>
        <p class="mt-4 max-w-165 text-[1.02rem] leading-relaxed text-[var(--color-muted)]">
          {t("about.title", lang)}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <ButtonLink
            href={localizedPath("cv", lang)}
            variant="primary"
            event="nav_section"
            eventData={{ section: "cv" }}
          >
            {t("about.cvLink", lang)}
            <IconArrowUpRight size={16} stroke={1.8} aria-hidden="true" />
          </ButtonLink>
          <ButtonLink
            href="#contacto"
            event="nav_section"
            eventData={{ section: "contacto" }}
          >
            {t("about.contactLink", lang)}
          </ButtonLink>
        </div>
      </div>
      <img
        src="/mauricio-dmo.webp"
        width="900"
        height="1013"
        alt={t("hero.photoAlt", lang)}
        class="mx-auto block h-[15rem] w-full max-w-80 object-contain object-bottom sm:h-[19rem]"
        fetchpriority="high"
      />
    </section>

    <AboutSection />
    <ProcessSection />

    <section class={sectionClass} id="contacto">
      <div class="mx-auto grid w-[min(calc(100%-2rem),1120px)] gap-5 md:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class={eyebrow}>{t("about.closingEyebrow", lang)}</p>
          <p class="mt-4 text-lg leading-relaxed text-[var(--color-muted)]">
            {t("about.closingText", lang)}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-muted)]">
          <a
            class="inline-flex items-center gap-2 no-underline transition-colors hover:text-(--color-text)"
            href={site.whatsapp}
            target="_blank"
            rel="noreferrer"
            data-track="contact_phone"
            data-track-source="about"
          >
            <IconPhone size={18} stroke={1.8} aria-hidden="true" />
            {site.phone}
          </a>
          <a
            class="inline-flex items-center gap-2 no-underline transition-colors hover:text-(--color-text)"
            href={`mailto:${site.email}`}
            data-track="contact_email"
            data-track-source="about"
          >
            <IconMail size={18} stroke={1.8} aria-hidden="true" />
            {site.email}
          </a>
          <a
            class="inline-flex items-center gap-2 no-underline transition-colors hover:text-(--color-text)"
            href={site.github}
            target="_blank"
            rel="noreferrer"
            data-track="social_link"
            data-track-network="github"
            data-track-source="about"
          >
            <IconBrandGithub size={18} stroke={1.8} aria-hidden="true" />
            GitHub
          </a>
          <a
            class="inline-flex items-center gap-2 no-underline transition-colors hover:text-(--color-text)"
            href={site.linkedin}
            target="_blank"
            rel="noreferrer"
            data-track="social_link"
            data-track-network="linkedin"
            data-track-source="about"
          >
            <IconBrandLinkedin size={18} stroke={1.8} aria-hidden="true" />
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter label="Sobre mí" homeLink />
</Layout>
