---
import {
  IconArrowUpRight,
  IconBrandGithub,
  IconBrandLinkedin,
  IconBuildingStore,
  IconMail,
  IconPhone,
} from "@tabler/icons-astro";
import ButtonLink from "../../components/ButtonLink.astro";
import CvSectionHeading from "../../components/CvSectionHeading.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { getLocale, localeMeta, localizedPath, t } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const pathname = localizedPath("contacto", lang);
const title = `${t("contact.eyebrow", lang)} | ${site.fullName}`;
const description = t("seo.contactDescription", lang);
const sectionClass = "pb-12";

const channels = [
  {
    label: t("contact.emailLabel", lang),
    value: site.email,
    href: `mailto:${site.email}`,
    icon: IconMail,
    track: "contact_email",
  },
  {
    label: t("contact.phoneLabel", lang),
    value: site.phone,
    href: site.whatsapp,
    icon: IconPhone,
    track: "contact_phone",
  },
  {
    label: "GitHub",
    value: "MauricioDMO",
    href: site.github,
    icon: IconBrandGithub,
    track: "social_link",
  },
  {
    label: "LinkedIn",
    value: "mauriciodmo",
    href: site.linkedin,
    icon: IconBrandLinkedin,
    track: "social_link",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: title,
    url: new URL(pathname, site.url).toString(),
    inLanguage: localeMeta[lang].lang,
    description,
    mainEntity: {
      "@type": "Person",
      name: site.fullName,
      alternateName: site.name,
      url: site.url,
      email: `mailto:${site.email}`,
      telephone: site.phone,
      sameAs: [site.linkedin, site.github, site.silverWolf],
      jobTitle: t("seo.jobTitle", lang),
    },
  },
];
---

<Layout
  title={title}
  description={description}
  pathname={pathname}
  structuredData={structuredData}
>
  <SiteHeader />

  <main>
    <section class="mx-auto w-[min(calc(100%-2rem),1120px)] py-14">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-accent)]">
        {t("contact.eyebrow", lang)}
      </p>
      <h1 class="mt-4 text-[clamp(2.75rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.06em] text-[var(--color-text)]">
        {t("contact.title", lang)}
      </h1>
      <div class="mt-8 grid gap-6 md:grid-cols-[1.2fr_0.8fr] md:items-end">
        <p class="text-[clamp(1.05rem,1.6vw,1.3rem)] leading-[1.6] text-[var(--color-muted)]">
          {t("contact.description", lang)}
        </p>
        <p class="text-sm text-[var(--color-muted)]">
          {t("hero.locationPrefix", lang)} {site.availability.location} · {t("hero.remoteAvailable", lang)}
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink
          href={`mailto:${site.email}`}
          variant="primary"
          event="contact_email"
          eventData={{ source: "contact" }}
        >
          <IconMail size={18} stroke={1.8} aria-hidden="true" />
          {t("contact.messageMe", lang)}
        </ButtonLink>
        <ButtonLink
          href={localizedPath("proyectos", lang)}
          event="nav_section"
          eventData={{ section: "proyectos", source: "contact" }}
        >
          {t("contact.browseProjects", lang)}
          <IconArrowUpRight size={18} stroke={1.8} aria-hidden="true" />
        </ButtonLink>
      </div>
    </section>

    <section class={sectionClass} id="canales">
      <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
        <CvSectionHeading label={t("contact.channelsTitle", lang)} />
        <ul class="mt-6 grid gap-3 p-0 sm:grid-cols-2">
          {
            channels.map(({ label, value, href, icon: ChannelIcon, track }) => (
              <li>
                <a
                  class="flex h-full items-center gap-4 rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)]/60 px-5 py-4 no-underline transition-colors hover:border-[var(--color-accent)]"
                  href={href}
                  target={href.startsWith("http") ? "_blank" : undefined}
                  rel={href.startsWith("http") ? "noreferrer" : undefined}
                  data-track={track}
                  data-track-source="contact"
                  data-track-network={label === "GitHub" || label === "LinkedIn" ? label.toLowerCase() : undefined}
                >
                  <ChannelIcon
                    class="shrink-0 text-[var(--color-accent)]"
                    size={22}
                    stroke={1.8}
                    aria-hidden="true"
                  />
                  <span class="min-w-0">
                    <span class="block font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-muted)]">
                      {label}
                    </span>
                    <span class="block break-all text-[var(--color-text)]">{value}</span>
                  </span>
                  <IconArrowUpRight
                    class="ml-auto shrink-0 text-[var(--color-muted)]"
                    size={18}
                    stroke={1.8}
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class={sectionClass} id="disponibilidad">
      <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
        <CvSectionHeading label={t("contact.availabilityTitle", lang)} />
        <p class="mt-5 max-w-190 text-lg leading-relaxed text-[var(--color-muted)]">
          {t("contact.availabilityText", lang)}
        </p>
      </div>
    </section>

    <section class={sectionClass} id="servicios">
      <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
        <CvSectionHeading label={t("contact.servicesTitle", lang)} />
        <div class="mt-5 grid gap-5 md:grid-cols-[1.2fr_0.8fr] md:items-center">
          <p class="text-lg leading-relaxed text-[var(--color-muted)]">
            {t("contact.servicesText", lang)}
          </p>
          <div>
            <ButtonLink
              href={site.silverWolf}
              target="_blank"
              rel="noreferrer"
              event="external_link"
              eventData={{ destination: "silver-wolf", source: "contact" }}
            >
              <IconBuildingStore size={18} stroke={1.8} aria-hidden="true" />
              {t("contact.silverWolfCta", lang)}
              <IconArrowUpRight size={18} stroke={1.8} aria-hidden="true" />
            </ButtonLink>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter label={t("contact.eyebrow", lang)} homeLink />
</Layout>
