<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>MauricioDMO — Language / Idioma</title>
    <script is:inline>
      (() => {
        let preference;
        try {
          preference = localStorage.getItem("locale");
        } catch {}
        if (preference !== "es" && preference !== "en") {
          const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
          preference = languages
            .map((language) => language?.toLowerCase().split("-")[0])
            .find((language) => language === "es" || language === "en") || "en";
        }
        location.replace(`/${preference}/${location.search}${location.hash}`);
      })();
    </script>
  </head>
  <body>
    <main>
      <h1>Choose your language / Elige tu idioma</h1>
      <p><a href="/en/">English</a> · <a href="/es/">Español</a></p>
    </main>
  </body>
</html>
