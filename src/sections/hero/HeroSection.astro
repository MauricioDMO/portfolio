---
import {
  IconFileCv,
  IconLayoutGrid,
  IconMapPin,
  IconMessage,
} from "@tabler/icons-astro";
import { computeTimeline } from "tegaki";
import TegakiRenderer from "tegaki/astro";
import caveat from "tegaki/fonts/caveat";
import ButtonLink from "../../components/ButtonLink.astro";
import { site } from "../../data/site";
import { getLocale, localizedPath, t } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const heroTitleLines = [t("hero.titleLine1", lang), t("hero.titleLine2", lang)];
const heroTitle = heroTitleLines.join(" ");
const heroTitleSpeed = 10;
const secondLineDelay =
  computeTimeline(heroTitleLines[0], caveat).totalDuration / heroTitleSpeed +
  0.12;

---

<section class="mx-auto grid w-[min(calc(100%-2rem),1120px)] items-center gap-8 py-16 md:grid-cols-[1.12fr_0.88fr] md:py-20 lg:gap-12">
  <div class="max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
      {t("hero.eyebrow", lang)}
    </p>
    <h1 class="sr-only">{heroTitle}</h1>
    <div
      class="mt-5 max-w-190 space-y-[-0.42rem] text-[var(--color-text)]"
      transition:name="page-title"
      aria-hidden="true"
    >
      {heroTitleLines.map((line, index) => (
        <TegakiRenderer
          font={caveat}
          text={line}
          time={{
            mode: "uncontrolled",
            speed: heroTitleSpeed,
            delay: index === 0 ? 0 : secondLineDelay,
          }}
          style={{
            fontSize: "clamp(3.2rem, 7vw, 6.4rem)",
            lineHeight: "0.86",
            letterSpacing: "-0.055em",
          }}
        />
      ))}
    </div>
    <p class="mt-6 max-w-165 text-[clamp(1.02rem,1.5vw,1.2rem)] leading-[1.65] text-[var(--color-muted)]">
      {t("hero.intro", lang)}
    </p>
    {
      site.availability.remote && (
        <p class="mt-3 flex items-center gap-2 text-sm text-[var(--color-muted)]">
          <IconMapPin size={16} stroke={1.8} aria-hidden="true" />
          <span>
            {t("hero.locationPrefix", lang)} {site.availability.location}. {t("hero.remoteAvailable", lang)}
          </span>
        </p>
      )
    }
    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink
        href={localizedPath("proyectos", lang)}
        variant="primary"
        event="nav_section"
        eventData={{ section: "proyectos", source: "hero" }}
      >
        <IconLayoutGrid size={18} stroke={1.8} aria-hidden="true" />
        {t("hero.seeProjectsCta", lang)}
      </ButtonLink>
      <ButtonLink
        href={localizedPath("cv", lang)}
        event="nav_section"
        eventData={{ section: "cv", source: "hero" }}
      >
        <IconFileCv size={18} stroke={1.8} aria-hidden="true" />
        {t("hero.cvCta", lang)}
      </ButtonLink>
      <ButtonLink
        href={localizedPath("contacto", lang)}
        event="nav_section"
        eventData={{ section: "contacto", source: "hero" }}
      >
        <IconMessage size={18} stroke={1.8} aria-hidden="true" />
        {t("hero.talkCta", lang)}
      </ButtonLink>
    </div>
  </div>

  <div class="relative overflow-hidden rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)]/75">
    <div
      class="pointer-events-none absolute -left-12 top-10 h-40 w-40 rounded-full bg-[var(--color-accent)]/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <img
      src="/mauricio-dmo.webp"
      width="900"
      height="1013"
      alt={t("hero.photoAlt", lang)}
      class="relative mx-auto block h-[16rem] w-full object-contain object-bottom sm:h-[20rem]"
      fetchpriority="high"
    />
  </div>
</section>
