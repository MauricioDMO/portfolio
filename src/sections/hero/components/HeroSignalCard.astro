---
import { getLocale, t } from '../../../i18n';

const lang = getLocale(Astro.currentLocale);
const strengths = [
  ['Web comercial', 'Landings, sitios informativos y rutas claras para convertir visitas en contacto.'],
  ['Experiencia de uso', 'Interfaces fáciles de leer, navegar y usar en desktop o móvil.'],
  ['Sistemas internos', 'Herramientas para facturación, inventario, garantías y flujos operativos.'],
];

const signals = [
  ['+300', 'facturas/mes'],
  ['4', 'proyectos reales'],
  ['ES', 'El Salvador'],
];
---

<aside class="relative overflow-hidden rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)]/75 p-5 shadow-[0_24px_80px_rgba(0,0,0,0.22)]" aria-label={t('hero.signalLabel', lang)}>
  <div class="pointer-events-none absolute -right-16 -top-20 h-48 w-48 rounded-full bg-[var(--color-accent)]/10 blur-3xl" aria-hidden="true"></div>
  <div class="relative">
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">{t('hero.cardEyebrow', lang)}</p>
    <p class="mt-4 leading-relaxed text-[var(--color-muted)]">
      <strong class="text-[var(--color-text)]">{t('hero.cardLead', lang)}</strong>{" "}
      {t('hero.cardBody', lang)}
    </p>

    <div class="mt-5 divide-y divide-[var(--color-border)]/80 border-y border-[var(--color-border)]/80">
      {
        strengths.map(([title, text]) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[0.42fr_0.58fr]">
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.08em] text-[var(--color-accent)]">{t(title, lang)}</p>
            <p class="text-sm leading-relaxed text-[var(--color-muted)]">{t(text, lang)}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-4 grid grid-cols-3 gap-2">
      {
        signals.map(([value, label]) => (
          <div class="rounded border border-white/10 bg-[var(--color-bg)]/45 p-3">
            <strong class="block text-xl leading-none text-[var(--color-accent)]">{value}</strong>
            <span class="mt-2 block text-[0.7rem] leading-tight text-[var(--color-muted)]">{t(label, lang)}</span>
          </div>
        ))
      }
    </div>
  </div>
</aside>
