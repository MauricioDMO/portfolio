---
import type { CollectionEntry } from "astro:content";
import { IconArrowUpRight } from "@tabler/icons-astro";
import ButtonLink from "../../components/ButtonLink.astro";
import { getLocale, localizedPath, t } from "../../i18n";
import { getPublishedEntries } from "../../lib/content";

const lang = getLocale(Astro.currentLocale);
const entries = (await getPublishedEntries("blog", lang)) as CollectionEntry<"blog">[];
const posts = [...entries]
  .filter((entry) => entry.data.publishedAt)
  .sort((a, b) => b.data.publishedAt!.getTime() - a.data.publishedAt!.getTime())
  .slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="border-t border-[var(--color-border)]/60 py-18" id="blog">
      <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
          {t("blog.recentEyebrow", lang)}
        </p>
        <h2 class="mt-4 text-[clamp(2rem,4vw,3.6rem)] leading-none tracking-[-0.06em] text-[var(--color-text)]">
          {t("blog.recentTitle", lang)}
        </h2>
        <ul class="mt-10 grid gap-5 p-0 md:grid-cols-3">
          {posts.map((post) => (
            <li>
              <a
                class="group flex h-full flex-col rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)]/60 p-5 no-underline transition-colors hover:border-[var(--color-accent)]"
                href={`/${lang}/blog/${post.data.slug}/`}
                data-track="nav_section"
                data-track-section="blog"
                data-track-source="home"
              >
                <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
                  {t(`blog.categories.${post.data.category}`, lang)}
                </p>
                <h3 class="mt-3 text-xl leading-tight text-[var(--color-text)]">
                  {post.data.title}
                </h3>
                <p class="mt-3 text-sm text-[var(--color-muted)]">{post.data.description}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm text-[var(--color-accent)]">
                  {t("blog.readPost", lang)}
                  <IconArrowUpRight size={16} stroke={1.8} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <ButtonLink
            href={localizedPath("blog", lang)}
            event="nav_section"
            eventData={{ section: "blog", source: "home" }}
          >
            {t("blog.viewAll", lang)}
            <IconArrowUpRight size={18} stroke={1.8} aria-hidden="true" />
          </ButtonLink>
        </div>
      </div>
    </section>
  )
}
