---
import SectionHeader from '../../components/SectionHeader.astro';
import { featuredProjects } from '../../data/projects';
import { getLocale, t } from '../../i18n';
import ProjectCard from './components/ProjectCard.astro';

const lang = getLocale(Astro.currentLocale);
---

<section class="border-t border-[#26352c]/60 py-18" id="proyectos">
  <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
    <SectionHeader
      eyebrow={t('projectsSection.eyebrow', lang)}
      title={t('projectsSection.title', lang)}
      description={t('projectsSection.description', lang)}
    />

    <div class="grid gap-4 md:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
