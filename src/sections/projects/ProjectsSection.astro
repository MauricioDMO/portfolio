---
import { IconArrowRight, IconArrowUpRight } from '@tabler/icons-astro';
import ButtonLink from '../../components/ButtonLink.astro';
import { getLocale, localizedPath, t } from '../../i18n';
import { getPublishedEntries } from '../../lib/content';

const lang = getLocale(Astro.currentLocale);
const featuredProjects = (await getPublishedEntries('projects', lang))
  .filter((entry) => entry.collection === 'projects' && entry.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))
  .slice(0, 4);
---

<section class="border-t border-[var(--color-border)]/60 py-18" id="proyectos">
  <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
    <div class="grid items-center gap-10 md:grid-cols-[1.2fr_1fr] md:gap-12">
      <div class="grid aspect-[4/3] grid-flow-dense grid-cols-2 grid-rows-5 gap-2 sm:gap-3">
        {featuredProjects.map((entry, index) => (
          <a
            href={`/${lang}/${lang === 'es' ? 'proyectos' : 'projects'}/${entry.data.slug}/`}
            aria-label={entry.data.title}
            class:list={[
              'group overflow-hidden rounded-md border border-[var(--color-border)] bg-[var(--color-card)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]',
              index % 2 === 0 ? 'col-start-1' : 'col-start-2',
              index === 0 || index === 3 ? 'row-span-3' : 'row-span-2',
            ]}
            data-track="project_case_open"
            data-track-project={entry.data.id}
          >
            {entry.data.gallery[0] ? (
              <img src={entry.data.gallery[0].src} alt="" loading="lazy" decoding="async" transition:name={`project-image-${entry.data.id}`} class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none" />
            ) : (
              <span class="flex h-full items-center justify-center p-4 text-center text-sm text-[var(--color-muted)]">{entry.data.title}</span>
            )}
          </a>
        ))}
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">{t('projectsSection.eyebrow', lang)}</p>
        <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)] leading-[1.1] tracking-[-0.04em] text-[var(--color-text)]">{t('projectsSection.title', lang)}</h2>
        <p class="mt-5 max-w-lg leading-relaxed text-[var(--color-muted)]">{t('projectsSection.description', lang)}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href={localizedPath('proyectos', lang)} variant="primary">
            {t('projectsSection.viewAllCta', lang)} <IconArrowRight size={18} aria-hidden="true" />
          </ButtonLink>
          <ButtonLink href="#contacto">
            {t('projectsSection.workTogetherCta', lang)} <IconArrowUpRight size={18} aria-hidden="true" />
          </ButtonLink>
        </div>
      </div>
    </div>
  </div>
</section>
