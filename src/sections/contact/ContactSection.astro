---
import {
  IconArrowUpRight,
  IconBrandGithub,
  IconBrandLinkedin,
  IconMail,
} from "@tabler/icons-astro";
import ButtonLink from "../../components/ButtonLink.astro";
import { site } from "../../data/site";
import { getLocale, t } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
---

<section class="border-t border-[var(--color-border)]/60 py-18" id="contacto">
  <div class="mx-auto grid w-[min(calc(100%-2rem),1120px)] gap-9 md:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
        {t("contact.eyebrow", lang)}
      </p>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3.6rem)] leading-none tracking-[-0.06em] text-[var(--color-text)]">
        {t("contact.title", lang)}
      </h2>
    </div>
    <div>
      <p class="text-lg leading-relaxed text-[var(--color-muted)]">
        {t("contact.description", lang)}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink
          href={`mailto:${site.email}`}
          variant="primary"
          event="contact_email"
          eventData={{ source: "contact" }}
        >
          <IconMail size={18} stroke={1.8} aria-hidden="true" />
          {t("contact.messageMe", lang)}
        </ButtonLink>
        <ButtonLink
          href="#proyectos"
          event="nav_section"
          eventData={{ section: "proyectos", source: "contact" }}
        >
          {t("contact.browseProjects", lang)}
          <IconArrowUpRight size={18} stroke={1.8} aria-hidden="true" />
        </ButtonLink>
      </div>
      <div class="mt-6 flex flex-wrap gap-3 text-sm">
        <a
          class="inline-flex items-center gap-2 text-[var(--color-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
          href={site.github}
          target="_blank"
          rel="noreferrer"
          data-track="social_link"
          data-track-network="github"
          data-track-source="contact"
        >
          <IconBrandGithub size={18} stroke={1.8} aria-hidden="true" />
          GitHub
        </a>
        <a
          class="inline-flex items-center gap-2 text-[var(--color-muted)] no-underline transition-colors hover:text-[var(--color-text)]"
          href={site.linkedin}
          target="_blank"
          rel="noreferrer"
          data-track="social_link"
          data-track-network="linkedin"
          data-track-source="contact"
        >
          <IconBrandLinkedin size={18} stroke={1.8} aria-hidden="true" />
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
