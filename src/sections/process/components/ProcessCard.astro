---
type Props = {
  index: number;
  title: string;
  text: string;
  Icon: any;
  class?: string;
  revealDelay?: string;
};

type RevealStyle = {
  '--reveal-delay': string;
};

const { index, title, text, Icon, class: className, revealDelay = '0ms' } = Astro.props;
const revealStyle: RevealStyle = { '--reveal-delay': revealDelay };
---

<article
  class:list={["rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)]/75 p-6", className]}
  data-process-reveal
  style={revealStyle}
>
  <div class="flex items-center justify-between gap-4">
    <span class="font-mono text-xs text-[var(--color-accent)]">{String(index + 1).padStart(2, '0')}</span>
    <Icon className="text-[var(--color-accent)]" size={22} stroke={1.7} aria-hidden="true" />
  </div>
  <h3 class="mt-4 tracking-[-0.04em] text-[var(--color-text)]">{title}</h3>
  <p class="mt-3 leading-relaxed text-[var(--color-muted)]">{text}</p>
</article>
