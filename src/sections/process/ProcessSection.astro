---
import {
  IconBrain,
  IconCode,
  IconRefresh,
  IconRoute,
  IconSearch,
} from "@tabler/icons-astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getLocale, t } from "../../i18n";
import ProcessCard from "./components/ProcessCard.astro";

const lang = getLocale(Astro.currentLocale);

const process = [
  {
    title: "Entender",
    text: "Escuchar, investigar y comprender el problema.",
    Icon: IconSearch,
  },
  {
    title: "Razonar",
    text: "Cuestionar alternativas y definir prioridades.",
    Icon: IconBrain,
  },
  {
    title: "Plantear",
    text: "Diseñar una solución simple y sostenible.",
    Icon: IconRoute,
  },
  {
    title: "Implementar",
    text: "Convertir las ideas en software funcional.",
    Icon: IconCode,
  },
  {
    title: "Mejorar",
    text: "Aprender del uso real e iterar.",
    Icon: IconRefresh,
  },
];

const revealDurationMs = 300;
const revealDelayStepMs = revealDurationMs / 2;
---

<section class="border-t border-[var(--color-border)]/60 py-18" id="proceso">
  <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
    <SectionHeader
      eyebrow={t("workflow.eyebrow", lang)}
      title={t("workflow.title", lang)}
      description={t("workflow.description", lang)}
    />

    <div class="grid gap-3 md:grid-cols-4">
      {process.map((step, index) => (
        <ProcessCard
          index={index}
          title={t(step.title, lang)}
          text={t(step.text, lang)}
          Icon={step.Icon}
          class={
            index === process.length - 1
              ? "md:col-span-2 md:col-start-2"
              : "md:col-span-2"
          }
          revealDelay={`${index * revealDelayStepMs}ms`}
        />
      ))}
    </div>
  </div>
  <noscript>
    <style is:inline>
      #proceso [data-process-reveal] { opacity: 1; transform: none; }
    </style>
  </noscript>
</section>

<script>
  const initProcessReveal = () => {
    const cards = document.querySelectorAll<HTMLElement>(
      "#proceso [data-process-reveal]",
    );

    if (!cards.length) return;

    const revealCards = () => {
      cards.forEach((card) =>
        card.setAttribute("data-process-visible", "true"),
      );
    };

    if (!("IntersectionObserver" in window)) {
      revealCards();
      return;
    }

    const triggerCard = cards[0];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          revealCards();
          observer.disconnect();
        });
      },
      {
        rootMargin: "0px 0px -14% 0px",
        threshold: 0.25,
      },
    );

    observer.observe(triggerCard);
  };

  document.addEventListener("astro:page-load", initProcessReveal);
  initProcessReveal();
</script>

<style>
  :global(#proceso [data-process-reveal]) {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 520ms ease var(--reveal-delay),
      transform 640ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay),
      border-color 180ms ease,
      background-color 180ms ease;
    will-change: opacity, transform;
  }

  :global(#proceso [data-process-reveal][data-process-visible="true"]) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#proceso [data-process-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>
