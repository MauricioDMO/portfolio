---
type Props = {
  title: string;
  text: string;
  Icon: any;
};

const { title, text, Icon } = Astro.props;
---

<article
  class="rounded-md border border-[var(--color-border)] bg-[var(--color-card)]/75 p-5 md:col-span-3"
>
  <div class="flex items-center gap-3">
    <Icon
      className="shrink-0 text-[var(--color-accent)]"
      size={24}
      stroke={1.7}
      aria-hidden="true"
    />
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
      {title}
    </p>
  </div>
  <p class="mt-3 leading-relaxed text-[var(--color-muted)]">{text}</p>
</article>
