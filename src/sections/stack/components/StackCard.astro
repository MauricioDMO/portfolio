---
type Props = {
  title: string;
  text: string;
  Icon: any;
  offset?: boolean;
};

const { title, text, Icon, offset = false } = Astro.props;
---

<article
  class={`rounded-md border border-[var(--color-border)] bg-[var(--color-card)]/75 p-5 md:col-span-2 ${offset ? "md:col-start-2" : ""}`}
>
  <Icon
    className="mb-4 text-[var(--color-accent)]"
    size={24}
    stroke={1.7}
    aria-hidden="true"
  />
  <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
    {title}
  </p>
  <p class="mt-3 leading-relaxed text-[var(--color-muted)]">{text}</p>
</article>
