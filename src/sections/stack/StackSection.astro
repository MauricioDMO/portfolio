---
import {
  IconCode,
  IconDatabase,
  IconServer,
  IconSparkles,
} from "@tabler/icons-astro";
import SectionHeader from "../../components/SectionHeader.astro";
import TechPill from "../../components/TechPill.astro";
import { getLocale, t } from "../../i18n";
import { techs, type Tech } from "../../data/techs";
import StackCard from "./components/StackCard.astro";

const lang = getLocale(Astro.currentLocale);

type StackItem = [title: string, text: string, Icon: typeof IconCode];

const stack: StackItem[] = [
  ["stack.specialtySoftwareTitle", "stack.specialtySoftwareText", IconCode],
  ["stack.specialtyAiTitle", "stack.specialtyAiText", IconSparkles],
  ["stack.specialtyInfraTitle", "stack.specialtyInfraText", IconServer],
  ["stack.specialtyDataTitle", "stack.specialtyDataText", IconDatabase],
];
---

<section class="border-t border-[var(--color-border)]/60 py-18" id="stack">
  <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
    <SectionHeader
      eyebrow={t("stack.eyebrow", lang)}
      title={t("stack.title", lang)}
      description={t("stack.description", lang)}
    />

    <div
      class="mb-8 flex flex-wrap [flex-wrap:wrap_balance]! gap-2.5 justify-center"
      aria-label={t("stack.techLabel", lang)}
    >
      {(Object.values(techs) as Tech[]).map((tech) => (
        <TechPill
          name={tech.name}
          src={tech.icon}
          lightSrc={tech.iconLight}
          Icon={tech.Icon}
          href={tech.href}
          color={tech.color}
        />
      ))}
    </div>

    <div class="grid gap-3 md:grid-cols-6">
      {stack.map(([title, text, Icon]) => (
        <StackCard
          title={t(title, lang)}
          text={t(text, lang)}
          Icon={Icon}
        />
      ))}
    </div>
  </div>
</section>
