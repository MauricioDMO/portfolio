---
import { techs, type Tech, type TechKey } from '../data/techs';
import { getLocale, t } from '../i18n';

type Props = {
  stack: string[];
  label: string;
  limit?: number;
  compact?: boolean;
  class?: string;
};

const lang = getLocale(Astro.currentLocale);
const {
  stack,
  label,
  limit,
  compact = false,
  class: className = '',
} = Astro.props;
const items = typeof limit === 'number' ? stack.slice(0, limit) : stack;
const textColor = compact ? 'text-[var(--color-muted)]' : 'text-[var(--color-text)]';
---

<div class={className}>
  <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
    {t('components.tools', lang)}
  </p>
  <ul class="mt-3 flex flex-wrap [flex-wrap:wrap_balance]! gap-2 p-0" aria-label={t(label, lang)}>
    {
      items.map((item) => {
        const normalized = item.trim().toLowerCase();
        const tech: Tech | undefined = (Object.hasOwn(techs, normalized) ? techs[normalized as TechKey] : undefined) ??
          Object.values(techs).find((candidate) => candidate.name.toLowerCase() === normalized);
        const TechIcon = tech?.Icon;

        return (
          <li class="list-none">
            <span
              class={`inline-flex items-center gap-1.5 rounded-full border border-white/10 px-2.5 py-1.5 font-mono text-xs ${textColor}`}
              style={tech ? `--tech-color: ${tech.color}` : undefined}
            >
              {tech?.icon && <img class={`${tech.iconLight ? 'tech-icon ' : ''}size-3.5 object-contain`} src={tech.icon} alt="" aria-hidden="true" />}
              {tech?.iconLight && !TechIcon && <img class="tech-icon-light size-3.5 object-contain" src={tech.iconLight} alt="" aria-hidden="true" />}
              {TechIcon && <TechIcon class="size-3.5 shrink-0 text-[var(--color-accent)]" size={14} stroke={1.7} aria-hidden="true" />}
              <span>{tech?.name ?? item}</span>
            </span>
          </li>
        );
      })
    }
  </ul>
</div>
