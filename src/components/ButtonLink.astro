---
type Props = {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  download?: string;
  class?: string;
  target?: string;
  rel?: string;
  event?: string;
  eventData?: Record<string, string>;
};

const { href, variant = "secondary", download, class: customClass, target, rel, event, eventData } = Astro.props;

const tracking = event
  ? {
      "data-track": event,
      ...Object.fromEntries(
        Object.entries(eventData ?? {}).map(([key, value]) => [`data-track-${key}`, value]),
      ),
    }
  : {};

const base =
  "inline-flex items-center justify-center gap-2 font-semibold no-underline transition";
const variants = {
  primary:
    "min-h-11 rounded-[6px] border border-[var(--color-accent)]/55 bg-gradient-to-br from-[#1f5e3b] to-[#183a2a] px-4 text-[#e8eee9] hover:-translate-y-0.5 hover:border-[var(--color-accent)]",
  secondary:
    "min-h-11 rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)] px-4 text-[var(--color-text)] hover:-translate-y-0.5 hover:border-[var(--color-accent)]/70",
  ghost:
    "min-h-9 gap-1.5 rounded-[4px] border border-[var(--color-border)] px-3 text-sm text-[var(--color-accent)] hover:border-[var(--color-accent)]/60 hover:bg-[var(--color-card)]",
};
---

<a class={`${base} ${variants[variant]} ${customClass || ""}`} href={href} download={download} target={target} rel={rel} {...tracking}>
  <slot />
</a>
