---
type Props = {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
  target?: string;
  rel?: string;
  event?: string;
  eventData?: Record<string, string>;
};

const { href, variant = "secondary", class: customClass, target, rel, event, eventData } = Astro.props;

const tracking = event
  ? {
      "data-track": event,
      ...Object.fromEntries(
        Object.entries(eventData ?? {}).map(([key, value]) => [`data-track-${key}`, value]),
      ),
    }
  : {};

const base =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-[6px] border px-4 font-semibold text-[#e8eee9] no-underline transition hover:-translate-y-0.5";
const variants = {
  primary:
    "border-[#5faf7b]/55 bg-gradient-to-br from-[#1f5e3b] to-[#183a2a] hover:border-[#5faf7b]",
  secondary:
    "border-[#26352c] bg-[#16211b] hover:border-[#5faf7b]/70 hover:bg-[#18271f]",
};
---

<a class={`${base} ${variants[variant]} ${customClass || ""}`} href={href} target={target} rel={rel} {...tracking}>
  <slot />
</a>
