---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="mb-8 flex items-center gap-4 border-t border-[var(--color-border)] pt-6">
  <span
    class="h-[3px] w-10 shrink-0 bg-[var(--color-accent)]"
    aria-hidden="true"
  ></span>
  <h2
    class="font-mono text-base font-semibold uppercase tracking-[0.12em] text-[var(--color-accent)]"
  >
    {label}
  </h2>
</div>
