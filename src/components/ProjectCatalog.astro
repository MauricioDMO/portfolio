---
import type { CollectionEntry } from "astro:content";
import { IconArrowUpRight } from "@tabler/icons-astro";
import { t, type Locale } from "../i18n";
import ProjectTools from "./ProjectTools.astro";
import CustomSelect from "./CustomSelect.astro";

/**
 * Fase 4 schema: eyebrow and status optional until verified; impact and gallery
 * always present, though gallery may be empty.
 */
type ProjectEntry = CollectionEntry<"projects"> & {
  data: {
    eyebrow?: string;
    status?: string;
    impact?: string[];
    gallery?: Array<{ src: string; alt: string }>;
  };
};

type Props = {
  entries: ProjectEntry[];
  lang: Locale;
};

const { entries, lang } = Astro.props;
const folder = lang === "es" ? "proyectos" : "projects";

const normalize = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();

const categoryLabels: Record<string, Record<Locale, string>> = {
  "business-software": { es: "Software empresarial", en: "Business Software" },
  "developer-tools": {
    es: "Herramientas de desarrollo",
    en: "Developer Tools",
  },
  infrastructure: { es: "Infraestructura", en: "Infrastructure" },
  experiments: { es: "Experimentos", en: "Experiments" },
};
const statusLabels: Record<string, Record<Locale, string>> = {
  production: { es: "En producción", en: "Production" },
  "in-development": { es: "En desarrollo", en: "In development" },
  experimental: { es: "Experimental", en: "Experimental" },
  completed: { es: "Completado", en: "Completed" },
  archived: { es: "Archivado", en: "Archived" },
  unspecified: { es: "Sin especificar", en: "Not specified" },
};
const labelFor = (map: Record<string, Record<Locale, string>>, key: string) =>
  map[key]?.[lang] ?? key;

/** Filter chrome is local: i18n files are out of scope for this phase. */
const ui = {
  es: {
    filters: "Filtrar proyectos",
    search: "Buscar proyectos",
    searchHint: "Título, descripción o tecnología",
    category: "Categoría",
    allCategories: "Todas las categorías",
    status: "Estado",
    allStatuses: "Todos los estados",
    sort: "Ordenar",
    featuredOrder: "Orden destacado",
    titleOrder: "Título",
    empty: "No se encontraron proyectos con estos filtros.",
  },
  en: {
    filters: "Filter projects",
    search: "Search projects",
    searchHint: "Title, description or technology",
    category: "Category",
    allCategories: "All categories",
    status: "Status",
    allStatuses: "All statuses",
    sort: "Sort",
    featuredOrder: "Featured order",
    titleOrder: "Title",
    empty: "No projects match these filters.",
  },
}[lang];

/** Featured order is the natural order of the list, so it must be applied on the server to avoid a reorder after hydration. */
const orderedEntries = [...entries].sort(
  (a, b) =>
    (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity),
);

const categories = [...new Set(entries.map((entry) => entry.data.category))];
const statuses = [
  ...new Set(entries.map((entry) => entry.data.status ?? "unspecified")),
];

const categoryOptions = [
  { value: "", label: ui.allCategories },
  ...categories.map((category) => ({
    value: category,
    label: labelFor(categoryLabels, category),
  })),
];
const statusOptions = [
  { value: "", label: ui.allStatuses },
  ...statuses.map((status) => ({
    value: status,
    label: labelFor(statusLabels, status),
  })),
];
const sortOptions = [
  { value: "featured", label: ui.featuredOrder },
  { value: "title", label: ui.titleOrder },
];
---

<section data-project-catalog aria-labelledby="catalog-heading">
  <header class="max-w-225">
    <h1
      id="catalog-heading"
      class="mt-0 text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.95] tracking-[-0.06em] text-[var(--color-text)]"
    >
      {t("Proyectos", lang)}
    </h1>
    <p class="mt-6 max-w-190 text-[clamp(1.05rem,1.6vw,1.3rem)] leading-[1.6] text-[var(--color-muted)]">
      {t("projectsSection.title", lang)}
    </p>
  </header>

  <div
    class="mt-12 flex flex-wrap items-end gap-4 rounded-[6px] border border-[var(--color-border)] bg-[var(--color-card)]/70 p-4 max-sm:flex-col max-sm:items-stretch"
    role="group"
    aria-label={ui.filters}
  >
    <div class="flex min-w-55 flex-1 flex-col gap-2">
      <label
        class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-muted)]"
        for="catalog-search"
      >
        {ui.search}
      </label>
      <input
        id="catalog-search"
        class="w-full rounded-[6px] border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-[var(--color-text)] placeholder:text-[var(--color-muted)]"
        type="search"
        placeholder={ui.searchHint}
        autocomplete="off"
        data-filter-search
      />
    </div>
    <CustomSelect
      id="catalog-category"
      label={ui.category}
      options={categoryOptions}
      class="min-w-45"
      data-filter-category
    />
    <CustomSelect
      id="catalog-sort"
      label={ui.sort}
      options={sortOptions}
      value="featured"
      class="min-w-45"
      data-filter-sort
    />
    <CustomSelect
      id="catalog-status"
      label={ui.status}
      options={statusOptions}
      class="min-w-45"
      data-filter-status
    />
  </div>

  <p
    class="mt-10 text-[var(--color-muted)]"
    data-no-results
    hidden={entries.length > 0}
  >
    {ui.empty}
  </p>

  <ul class="mt-10 grid list-none gap-6 p-0 sm:grid-cols-2" data-catalog-list>
    {orderedEntries.map((entry) => {
      const { title, description, category, slug, technologies, eyebrow } =
        entry.data;
      const status = entry.data.status ?? "unspecified";
      const image = entry.data.gallery?.[0];
      const searchText = normalize(
        [
          title,
          description,
          eyebrow ?? "",
          ...technologies,
          labelFor(categoryLabels, category),
          labelFor(statusLabels, status),
        ].join(" "),
      );
      const href = `/${lang}/${folder}/${slug}/`;
      return (
        <li
          class="list-none"
          data-catalog-item
          data-category={category}
          data-status={status}
          data-search={searchText}
          data-order={entry.data.featuredOrder ?? 999999}
          data-title={normalize(title)}
        >
          <article class="group relative flex h-full flex-col overflow-hidden rounded-[6px] border border-[var(--color-border)] bg-gradient-to-b from-[var(--color-card)]/95 to-[var(--color-surface)]/95 transition hover:-translate-y-0.5 hover:border-[var(--color-accent)]/70">
            <div class="p-5">
              <p class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-accent)]">
                {labelFor(categoryLabels, category)}
                <span class="text-[var(--color-muted)]">
                  {" "}
                  · {labelFor(statusLabels, status)}
                </span>
              </p>
              <h2 class="mt-3 text-[clamp(1.35rem,2.6vw,1.85rem)] leading-[1.1] tracking-[-0.04em] text-[var(--color-text)]">
                <a
                  class="no-underline transition-colors hover:text-[var(--color-accent)]"
                  href={href}
                  data-track="project_case_open"
                  data-track-project={entry.data.id}
                >
                  <span transition:name={`project-title-${entry.data.id}`}>
                    {title}
                  </span>
                  <span class="absolute inset-0 z-10" aria-hidden="true"></span>
                </a>
              </h2>
            </div>
            {image ? (
              <div class="aspect-[16/9] overflow-hidden border-y border-[var(--color-border)] bg-[var(--color-bg)]/70">
                <img
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  transition:name={`project-image-${entry.data.id}`}
                />
              </div>
            ) : null}
            <div class="flex flex-1 flex-col p-5">
              <p class="leading-relaxed text-[var(--color-muted)]">
                {description}
              </p>
              {technologies.length > 0 ? (
                <ProjectTools
                  class="mt-5"
                  stack={technologies}
                  label={`${t("projectPage.stackPrefix", lang)} ${title}`}
                  compact
                />
              ) : null}
              <div class="mt-auto flex justify-center pt-6">
                <span class="inline-flex w-fit items-center justify-center gap-2 rounded-full bg-[var(--color-accent)] px-4 py-2.5 font-mono text-xs uppercase tracking-[0.08em] text-[var(--color-bg)] transition group-hover:brightness-110">
                  {t("Ver caso completo", lang)}
                  <IconArrowUpRight
                    size={16}
                    stroke={2}
                    class="transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </span>
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ul>
</section>

<script>
  const normalizeFilter = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();

  function initCatalog() {
    const root = document.querySelector<HTMLElement>("[data-project-catalog]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const items = Array.from(
      root.querySelectorAll<HTMLElement>("[data-catalog-item]"),
    );
    const category = root.querySelector<HTMLElement>("[data-filter-category]");
    const status = root.querySelector<HTMLElement>("[data-filter-status]");
    const search = root.querySelector<HTMLInputElement>("[data-filter-search]");
    const sort = root.querySelector<HTMLElement>("[data-filter-sort]");
    const list = root.querySelector<HTMLElement>("[data-catalog-list]");
    const empty = root.querySelector<HTMLElement>("[data-no-results]");

    const apply = () => {
      const selectedCategory = category?.dataset.value ?? "";
      const selectedStatus = status?.dataset.value ?? "";
      const query = normalizeFilter(search?.value.trim() ?? "");
      let visible = 0;
      for (const item of items) {
        const matches =
          (!selectedCategory || item.dataset.category === selectedCategory) &&
          (!selectedStatus || item.dataset.status === selectedStatus) &&
          (!query || (item.dataset.search ?? "").includes(query));
        item.hidden = !matches;
        if (matches) visible += 1;
      }
      if (empty) empty.hidden = visible !== 0;
    };

    // Only reorder when the user explicitly changes the sort; keep the server-rendered order on load.
    const sortItems = () => {
      items.sort((a, b) =>
        sort?.dataset.value === "title"
          ? (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "")
          : Number(a.dataset.order) - Number(b.dataset.order),
      );
      if (list) items.forEach((item) => list.append(item));
    };

    category?.addEventListener("change", apply);
    status?.addEventListener("change", apply);
    search?.addEventListener("input", apply);
    sort?.addEventListener("change", () => {
      sortItems();
      apply();
    });
  }

  const focusSearchOnSlash = (event: KeyboardEvent) => {
    if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey)
      return;
    const target = event.target;
    if (
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        target.closest("[data-custom-select]") ||
        ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
    )
      return;
    const search = document.querySelector<HTMLInputElement>(
      "[data-project-catalog] [data-filter-search]",
    );
    if (!search) return;
    event.preventDefault();
    search.focus();
  };
  document.addEventListener("keydown", focusSearchOnSlash);

  // ClientRouter: astro:page-load fires on first load and after every swap.
  document.addEventListener("astro:page-load", initCatalog);
  initCatalog();
</script>

<style>
  /* [hidden] loses to display utilities without this higher-specificity rule. */
  [data-catalog-item][hidden],
  [data-no-results][hidden] {
    display: none;
  }
</style>
