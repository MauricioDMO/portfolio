---
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";
import {
  defaultLocale,
  getLocale,
  localeMeta,
  locales,
  switchLocalePath,
  type Locale,
} from "../i18n";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
  preloadImages?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Paths whose translation cannot be derived from the URL (e.g. blog slugs). */
  alternatePathnames?: Partial<Record<Locale, string>>;
};

const {
  title = site.title,
  description = site.description,
  pathname = Astro.url.pathname,
  image,
  type = "website",
  robots = "index, follow, max-image-preview:large",
  preloadImages = [],
  structuredData,
  alternatePathnames,
} = Astro.props;

const lang = getLocale(Astro.currentLocale);

const canonicalUrl = new URL(pathname, site.url).toString();
const imageUrl = new URL(image ?? "/mauricio-dmo.webp", site.url).toString();
const alternates = locales.map((locale) => ({
  locale,
  path: alternatePathnames?.[locale] ?? switchLocalePath(pathname, locale),
}));
const xDefault = alternates.find((item) => item.locale === defaultLocale)!;
const jsonLd = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
---

<!doctype html>
<html lang={localeMeta[lang].lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try {
        const preference = localStorage.getItem("theme");
        if (preference === "light" || preference === "dark") {
          document.documentElement.dataset.theme = preference;
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0d1210" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map(({ locale, path }) => (
        <link
          rel="alternate"
          hreflang={localeMeta[locale].lang}
          href={new URL(path, site.url).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(xDefault.path, site.url).toString()}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      preloadImages.map((src) => (
        <link rel="preload" as="image" href={src} />
      ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      jsonLd.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <script is:inline defer src="https://uma.mauriciodmo.com/script.js" data-website-id="20a9d75c-589a-4a8e-a583-02502ac16dd9" data-domains="mauriciodmo.com,www.mauriciodmo.com"></script>
    <ClientRouter />
    <script>
      declare global {
        interface Window {
          umami?: { track: (name: string, data?: Record<string, string>) => void };
        }
      }

      document.addEventListener("astro:after-swap", () => {
        if (/^\/(?:es\/proyectos|en\/projects|en\/proyectos|proyectos)\//.test(window.location.pathname) && !window.location.hash) {
          window.scrollTo({ left: 0, top: 0, behavior: "instant" });
        }
      });

      document.addEventListener("astro:before-swap", (event) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) event.newDocument.documentElement.dataset.theme = theme;
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const element = target.closest<HTMLElement>("[data-track]");
        if (!element?.dataset.track) return;

        const data: Record<string, string> = {};
        for (const [key, value] of Object.entries(element.dataset)) {
          if (key === "track" || !value) continue;
          data[key.slice(5).replace(/^[A-Z]/, (c) => c.toLowerCase())] = value;
        }
        window.umami?.track(element.dataset.track, data);
      });
    </script>
    <title>{title}</title>
  </head>
  <body class="text-pretty">
    <slot />
  </body>
</html>
